# ─── App ──────────────────────────────────────────────────────────────
# Public base URL (used in emails, share links, OG images)
APP_URL=http://localhost:3000
NODE_ENV=development
# 32-byte base64 key for envelope encryption of secrets at rest (e-invoicing keys, OTP secrets, API keys)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────
# App role: non-owner, non-superuser → RLS is enforced (see docker/postgres/init.sql)
DATABASE_URL=postgresql://zatcaweb_app:zatcaweb_app@localhost:5432/zatcaweb?schema=public
# Owner role used for migrations only
DATABASE_MIGRATION_URL=postgresql://zatcaweb_owner:zatcaweb_owner@localhost:5432/zatcaweb?schema=public
SHADOW_DATABASE_URL=postgresql://zatcaweb_owner:zatcaweb_owner@localhost:5432/zatcaweb_shadow?schema=public
TEST_DATABASE_URL=postgresql://zatcaweb_owner:zatcaweb_owner@localhost:5432/zatcaweb_test?schema=public

# ─── Auth (Auth.js v5) — Phase 2 ──────────────────────────────────────
# Generate: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ─── Redis (BullMQ, rate limiting) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible; MinIO in dev) ─────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zatcaweb
S3_ACCESS_KEY_ID=zatcaweb
S3_SECRET_ACCESS_KEY=zatcaweb-secret
S3_FORCE_PATH_STYLE=true

# ─── Email (SMTP; Mailpit in dev → http://localhost:8025) ─────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ZatcaWeb <no-reply@zatcaweb.local>"

# ─── SMS / WhatsApp provider (mock in dev) ────────────────────────────
MESSAGING_PROVIDER=mock

# ─── E-invoicing ──────────────────────────────────────────────────────
# mock | zatca   (mock is labelled "Sandbox / Simulation" in the UI)
EINVOICING_PROVIDER=mock
# sandbox | simulation | production  (endpoints configured in Phase 7 from official docs)
EINVOICING_ENVIRONMENT=sandbox

# ─── Observability (Phase 14) ─────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
