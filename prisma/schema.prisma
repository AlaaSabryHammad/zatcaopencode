// ZatcaWeb data model. See design/CLAUDE_CODE_PROMPT.md §5 and docs/DECISIONS.md.
//
// Conventions:
//   id        String   @id @default(uuid()) @db.Uuid
//   money     Decimal  @db.Decimal(18, 2) · quantity Decimal @db.Decimal(18, 4) · rate Decimal @db.Decimal(5, 2)
//   timestamps @db.Timestamptz(6), stored UTC, displayed Asia/Riyadh
//   every tenant table has organizationId (UUID, indexed, FK) + an RLS policy (see migrations/*_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_MIGRATION_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Platform-level key/value (schema version, seed markers).
model SystemInfo {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_info")
}

/// Fixed-window counters for the PostgreSQL rate-limit store (used when Redis isn't configured).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limit_bucket")
}

// ───────────────────────────── Identity ─────────────────────────────

enum ThemePreference {
  light
  dark
  system
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  email               String          @unique /// stored lower-cased
  phone               String?         @unique /// E.164, e.g. +966551234567
  passwordHash        String?         @map("password_hash")
  emailVerifiedAt     DateTime?       @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?       @map("phone_verified_at") @db.Timestamptz(6)
  locale              String          @default("ar")
  theme               ThemePreference @default(system)
  /// Envelope-encrypted TOTP secret (src/server/crypto.ts). Never returned to the client.
  twoFactorSecret     String?         @map("two_factor_secret")
  twoFactorEnabled    Boolean         @default(false) @map("two_factor_enabled")
  twoFactorEnabledAt  DateTime?       @map("two_factor_enabled_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?       @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?       @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount    Int             @default(0) @map("failed_login_count")
  lockedUntil         DateTime?       @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(6)

  sessions           Session[]
  accounts           Account[]
  verificationTokens VerificationToken[]
  otpCodes           OtpCode[]
  recoveryCodes      RecoveryCode[]
  memberships        Membership[]
  platformAdmin      PlatformAdmin?
  securityEvents     SecurityEvent[]
  invitationsSent    Invitation[]        @relation("InvitedBy")

  @@map("user")
}

/// Database session. The cookie holds a random token; only its SHA-256 is stored here.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  /// true until the second factor is verified — such sessions can only reach /auth/2fa.
  mfaPending     Boolean   @default(false) @map("mfa_pending")
  remember       Boolean   @default(false)
  activeOrgId    String?   @map("active_org_id") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// OAuth / SSO accounts (Auth.js-compatible shape; providers arrive later).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use email link tokens (hash only).
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_token")
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}

/// One-time SMS codes. `codeHash` = HMAC-SHA256(AUTH_SECRET, code); max 5 attempts.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  phone      String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@map("otp_code")
}

/// 2FA recovery codes (hash only, single use).
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

/// Platform super-admin (separate from tenant roles; MFA required).
model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admin")
}

/// User-level security events (sign-in, failed sign-in, 2FA changes, password reset). Not tenant data.
model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String
  ip        String?
  userAgent String?  @map("user_agent")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("security_event")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum OrganizationStatus {
  trial
  active
  suspended
}

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  slug                 String             @unique
  nameAr               String             @map("name_ar")
  nameEn               String?            @map("name_en")
  legalName            String?            @map("legal_name")
  crNumber             String?            @map("cr_number")
  /// 15 digits, starts and ends with 3 (format check only).
  vatNumber            String?            @map("vat_number")
  tin                  String?
  businessType         String?            @map("business_type")
  industry             String?
  employeesRange       String?            @map("employees_range")
  invoiceVolume        String?            @map("invoice_volume")
  logoKey              String?            @map("logo_key")
  brandColor           String?            @map("brand_color")
  defaultLocale        String             @default("ar") @map("default_locale")
  currency             String             @default("SAR")
  fiscalYearStartMonth Int                @default(1) @map("fiscal_year_start_month")
  /// reg | group | none
  vatStatus            String             @default("reg") @map("vat_status")
  /// Invoice template choice (Modern | Classic | Minimal | Corporate).
  invoiceTemplate      String             @default("Modern") @map("invoice_template")
  status               OrganizationStatus @default(trial)
  /// Onboarding wizard progress (0-6) and completion timestamp.
  onboardingStep       Int                @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at") @db.Timestamptz(6)
  createdById          String?            @map("created_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(6)

  address     OrganizationAddress?
  memberships Membership[]
  roles       Role[]
  invitations Invitation[]
  branches    Branch[]
  sequences   InvoiceSequence[]
  customers   Customer[]
  customerContacts CustomerContact[]
  categories  Category[]
  products    Product[]
  stockLevels StockLevel[]
  invoices    Invoice[]
  invoiceLines InvoiceLine[]
  payments    Payment[]
  shares      ShareLink[]
  expenseCategories ExpenseCategory[]
  expenses    Expense[]
  auditLogs   AuditLog[]

  @@map("organization")
}

/// Saudi National Address.
model OrganizationAddress {
  organizationId String   @id @map("organization_id") @db.Uuid
  buildingNo     String?  @map("building_no") /// 4 digits
  street         String?
  district       String?
  city           String?
  postalCode     String?  @map("postal_code") /// 5 digits
  additionalNo   String?  @map("additional_no") /// 4 digits
  shortAddress   String?  @map("short_address")
  country        String   @default("SA")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_address")
}

/// Physical location. The head-office branch is created by the onboarding wizard.
model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String /// unique per org (e.g. HO, RYD-01)
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  city           String?
  district       String?
  street         String?
  buildingNo     String?  @map("building_no")
  postalCode     String?  @map("postal_code")
  phone          String?
  email          String?
  isHeadOffice   Boolean  @default(false) @map("is_head_office")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequences    InvoiceSequence[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branch")
}

/// Gap-free document numbering. Numbers are allocated with SELECT … FOR UPDATE
/// inside the issuing transaction (Phase 6). One row per (org, branch?, type, year).
model InvoiceSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  /// Surrogate NULL-safe key: `${organizationId}:${branchId ?? '-'}:${documentType}:${year}`.
  /// (Postgres unique constraints ignore NULLs, so the compound key alone can't dedupe org-wide rows.)
  key            String   @unique
  /// TAX | SIMPLIFIED | QUOTATION | ...
  documentType   String   @map("document_type")
  /// Display pattern, e.g. INV-{YYYY}-{#####}
  prefix         String
  nextValue      Int      @default(1) @map("next_value")
  year           Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, branchId, documentType, year])
  @@index([organizationId])
  @@map("invoice_sequence")
}

/// Permission catalogue (keys like `invoice.issue`). Synced from src/server/rbac/permissions.ts.
model Permission {
  key         String  @id
  group       String
  description String?

  roles RolePermission[]

  @@map("permission")
}

/// System roles have organizationId = null and a fixed `key`; custom roles belong to one organization.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("role")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

enum MembershipStatus {
  active
  suspended
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(active)
  /// Optional branch scoping; empty = all branches.
  branchIds      String[]         @default([]) @map("branch_ids") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("membership")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String /// lower-cased
  roleId         String           @map("role_id") @db.Uuid
  branchIds      String[]         @default([]) @map("branch_ids") @db.Uuid
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String           @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("invitation")
}

/// Append-only audit trail for every tenant mutation (UPDATE/DELETE revoked + trigger).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  entity         String
  entityId       String?  @map("entity_id")
  action         String
  before         Json?
  after          Json?
  diff           Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
  @@map("audit_log")
}

// ───────────────────────────── Sales & catalog (Phase 4+) ─────────────────────────────

enum CustomerType {
  company
  individual
}

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  type             CustomerType @default(company)
  nameAr           String       @map("name_ar")
  nameEn           String?      @map("name_en")
  vatNumber        String?      @map("vat_number")
  crNumber         String?      @map("cr_number")
  email            String?
  phone            String?
  city             String?
  address          String?
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(18, 2)
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  notes            String?
  tags             String[]     @default([])
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  payments     Payment[]
  contacts     CustomerContact[]

  @@index([organizationId])
  @@index([organizationId, nameAr])
  @@map("customer")
}

model CustomerContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String
  role           String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contact")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("category")
}

enum ProductType {
  product
  service
  bundle
  variant
}

enum VatCategory {
  STANDARD
  ZERO
  EXEMPT
  OUT_OF_SCOPE
}

model Product {
  id            String      @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  type          ProductType @default(product)
  sku           String
  barcode       String?
  nameAr        String      @map("name_ar")
  nameEn        String?     @map("name_en")
  description   String?
  categoryId    String?     @map("category_id") @db.Uuid
  unit          String      @default("pcs")
  purchasePrice Decimal?    @map("purchase_price") @db.Decimal(18, 2)
  sellingPrice  Decimal     @map("selling_price") @db.Decimal(18, 2)
  vatCategory   VatCategory @default(STANDARD) @map("vat_category")
  vatRate       Decimal     @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  trackStock    Boolean     @default(true) @map("track_stock")
  minStock      Decimal     @default(0) @map("min_stock") @db.Decimal(18, 4)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockLevels  StockLevel[]
  lines        InvoiceLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("product")
}

/// Quantity on hand per product per branch (branchId null = unassigned).
model StockLevel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, branchId])
  @@index([organizationId])
  @@map("stock_level")
}

enum InvoiceType {
  TAX
  SIMPLIFIED
  CREDIT_NOTE
  DEBIT_NOTE
}

enum InvoiceStatus {
  draft
  issued
  viewed
  sent
  partially_paid
  paid
  pending
  cancelled
  credited
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Null while draft (allocated on issue).
  number         String?
  type           InvoiceType
  status         InvoiceStatus @default(draft)
  customerId     String?       @map("customer_id") @db.Uuid
  branchId       String?       @map("branch_id") @db.Uuid
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  currency       String        @default("SAR")
  subtotal       Decimal       @default(0) @map("subtotal") @db.Decimal(18, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxableAmount  Decimal       @default(0) @map("taxable_amount") @db.Decimal(18, 2)
  vatTotal       Decimal       @default(0) @map("vat_total") @db.Decimal(18, 2)
  otherCharges   Decimal       @default(0) @map("other_charges") @db.Decimal(18, 2)
  rounding       Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(18, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balanceDue     Decimal       @default(0) @map("balance_due") @db.Decimal(18, 2)
  notes          String?
  terms          String?
  supplyDate     DateTime?     @map("supply_date") @db.Date
  poRef          String?       @map("po_ref")
  contractRef    String?       @map("contract_ref")
  salespersonId  String?       @map("salesperson_id") @db.Uuid
  /// For credit/debit notes: the referenced original invoice + reason.
  originalInvoiceId String?    @map("original_invoice_id") @db.Uuid
  reason           String?
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuedById     String?       @map("issued_by_id") @db.Uuid
  /// Set on issue; locked invoices reject financial edits (service + DB trigger).
  lockedAt       DateTime?     @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  shares       ShareLink[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([organizationId, customerId])
  @@map("invoice")
}

/// Tokenized public link (view-only bilingual render). Token is 256-bit; only its hash is stored.
model ShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  viewedAt       DateTime? @map("viewed_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("share_link")
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  position       Int      @default(0)
  productId      String?  @map("product_id") @db.Uuid
  description    String
  descriptionAr  String?  @map("description_ar")
  qty            Decimal  @db.Decimal(18, 4)
  unit           String   @default("pcs")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  vatRate        Decimal  @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  netAmount      Decimal  @map("net_amount") @db.Decimal(18, 2)
  vatAmount      Decimal  @map("vat_amount") @db.Decimal(18, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@map("invoice_line")
}

enum PaymentMethod {
  cash
  bank
  mada
  card
  apple_pay
  cheque
  transfer
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String?       @map("invoice_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  amount         Decimal       @db.Decimal(18, 2)
  method         PaymentMethod
  date           DateTime      @db.Date
  reference      String?
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, invoiceId])
  @@map("payment")
}

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("expense_category")
}

enum ExpenseStatus {
  draft
  pending
  approved
  rejected
  paid
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  description    String
  date           DateTime      @db.Date
  amountInclVat  Decimal       @map("amount_incl_vat") @db.Decimal(18, 2)
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(18, 2)
  recoverable    Boolean       @default(true)
  branchId       String?       @map("branch_id") @db.Uuid
  reference      String?
  status         ExpenseStatus @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("expense")
}
